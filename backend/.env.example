# Copy to .env and fill in real values. `.env` is gitignored — never commit it.
# Generate a production JWT secret with: openssl rand -hex 32

ENV=development                  # development | test | production
DEBUG=false
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                  # json (production) | plain (local)
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE_TEST

JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated explicit origins. Never use "*" with credentialed CORS.
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=                    # staging/production frontend origin, added to CORS
COOKIE_SECURE=false              # true in production (forced when ENV=production)
COOKIE_DOMAIN=
BEHIND_PROXY=false               # true on Render/Railway: trust X-Forwarded-For

STORAGE_PROVIDER=local           # local (dev) | supabase (staging/production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
UPLOAD_MAX_MB=10
UPLOAD_DIR=uploads

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Fixed-window rate limits: MAX hits per WINDOW seconds, per IP (auth) or
# per user (uploads/messages). RATE_LIMIT_ENABLED=false disables all of them.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_SIGNUP_MAX=10
RATE_LIMIT_SIGNUP_WINDOW_SECONDS=60
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_MAX=60
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
RATE_LIMIT_MESSAGE_MAX=120
RATE_LIMIT_MESSAGE_WINDOW_SECONDS=60
